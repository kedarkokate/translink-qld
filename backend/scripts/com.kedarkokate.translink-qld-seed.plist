<?xml version="1.0" encoding="UTF-8"?>
<!--
  TransLink GTFS daily freshness check.

  Runs the wrapper at 06:00 local time. The wrapper HEADs the GTFS zip and
  exits ~1s if the upstream ETag matches what we already have in D1; only
  fires a full seed when TransLink has actually republished.

  Install (one-time):
    cp backend/scripts/com.kedarkokate.translink-qld-seed.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.kedarkokate.translink-qld-seed.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.kedarkokate.translink-qld-seed.plist
    rm ~/Library/LaunchAgents/com.kedarkokate.translink-qld-seed.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kedarkokate.translink-qld-seed</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kedar/Projects/TransLinkQLD/backend/scripts/run-seed-if-changed.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kedar/Projects/TransLinkQLD/backend</string>

    <!-- 06:00 local time, daily. If the laptop is asleep launchd defers
         to wake-up; if it's off, the run is skipped (no make-up). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kedar/Projects/TransLinkQLD/backend/seed-if-changed.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kedar/Projects/TransLinkQLD/backend/seed-if-changed.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
